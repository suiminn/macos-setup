<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.suiminn.reset-betterdisplay</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>sleep 10; "$HOME/bin/reset-betterdisplay.zsh"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/mutsu/Library/Logs/reset-betterdisplay.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/mutsu/Library/Logs/reset-betterdisplay.err.log</string>
</dict>
</plist>
